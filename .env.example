# Copiar este archivo a ".env" y completar los valores reales.
# El archivo ".env" NUNCA debe subirse al repositorio (ya esta en .gitignore).
#
#   cp .env.example .env
#
# Todas las variables que lee este compose empiezan con "ML_", excepto
# PIPELINE_SERVICE_TOKEN (ver mas abajo). Esto es deliberado: si ya se exporto
# POSTGRES_PASSWORD en la shell para el stack de Anomaly-Watch (el producto),
# ese valor NO debe terminar configurando el Postgres de este stack — Docker
# Compose le da prioridad a las variables de shell sobre las de ".env".

# --- Puertos publicados en el host ---
# Este stack se llama "anomaly-watch-ml" (ver docker-compose.yml, name:) y
# NUNCA publica los puertos reservados por el stack de Anomaly-Watch: 5432 db,
# 6379 redis, 8080 api, 3000 web, 8025 MailHog. Solo publica detector y
# postgres, en 127.0.0.1. Cambiar estos valores si ya estan ocupados en el host.
ML_DETECTOR_PORT=8003
ML_POSTGRES_PORT=5433

# --- PostgreSQL ---
# Sin default en el compose: si falta alguna, "docker compose up" falla
# nombrando la variable en vez de arrancar con una credencial adivinada.
ML_POSTGRES_USER=anomaly
ML_POSTGRES_DB=anomaly_watch
# Produccion: usar una contrasena fuerte y unica (min. 16 caracteres, generada
# aleatoriamente). Ejemplo para generarla: openssl rand -base64 24
ML_POSTGRES_PASSWORD=changeme

# --- detector-service ---
# Promover un modelo es cambiar esta linea y recrear el contenedor (sin
# rebuild): GET /model refleja el cambio.
ML_DETECTOR_MODEL_KEY=baseline-bert
ML_DETECTOR_THRESHOLD=0.5
ML_DETECTOR_MAX_BATCH_SIZE=256
ML_DETECTOR_MAX_LENGTH=256
# Acotado para que la inferencia no le saque CPU al stack de Anomaly-Watch
# cuando ambos corren en el mismo host.
ML_DETECTOR_NUM_THREADS=2

# --- Acceso a la API de Anomaly-Watch desde "replay" ---
# El contenedor "replay" llega a la API del stack de Anomaly-Watch a traves de
# host.docker.internal (el gateway del host), sin unirse a la red del stack
# producto. Funciona en cualquier orden de arranque; si el stack producto esta
# apagado, este stack arranca igual y el POST a esta URL simplemente falla.
ML_AW_ENDPOINT=http://host.docker.internal:8080
#
# Mismo nombre y mismo valor que en el .env del stack de Anomaly-Watch: con
# este token el pipeline (tools/replay.py --report-metrics) se autentica para
# reportar sus ventanas de latencia. Opcional: si falta, --report-metrics
# simplemente no puede autenticarse contra la API.
PIPELINE_SERVICE_TOKEN=changeme-pipeline-service-token
